{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/user-review/run-manifest.schema.json",
  "title": "用户评审运行清单",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "status", "research_goal", "source", "selection", "panel", "evidence"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string"},
    "status": {"enum": ["planned", "running", "partial", "completed", "failed"]},
    "selection": {"type": "object", "required": ["content_line", "explainable"]},
    "panel": {"type": "object", "required": ["planned_count", "worker_count", "quorum", "personas"]}
  }
}
