{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/user-panel-review/persona.schema.json",
  "title": "用户评审面板 Persona 元数据",
  "type": "object",
  "required": ["id", "version", "niche", "provenance", "confidence", "validation_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "niche": {"type": "string", "minLength": 1},
    "provenance": {"enum": ["grounded", "inferred", "operator_hypothesis", "synthetic"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "validation_status": {"enum": ["unvalidated", "partially_validated", "validated"]},
    "evidence_sources": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
