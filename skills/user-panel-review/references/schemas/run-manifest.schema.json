{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/user-panel-review/run-manifest.schema.json",
  "title": "用户评审面板运行清单",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "status", "research_goal", "source", "panel", "methods", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "status": {"enum": ["planned", "running", "partial", "completed", "failed"]},
    "source": {
      "type": "object",
      "required": ["name", "sha256", "snapshot"],
      "properties": {
        "name": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot": {"type": "string"}
      }
    },
    "methods": {"type": "array", "minItems": 1},
    "panel": {
      "type": "object",
      "required": ["planned_count", "quorum", "personas"],
      "properties": {
        "planned_count": {"type": "integer", "minimum": 1},
        "quorum": {"type": "integer", "minimum": 1},
        "personas": {"type": "array", "minItems": 1}
      }
    }
  },
  "additionalProperties": true
}
