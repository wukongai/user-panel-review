{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/user-panel-review/worker-result.schema.json",
  "title": "用户评审面板 Worker 结果",
  "type": "object",
  "required": [
    "schema_version", "run_id", "worker_result_id", "reviewer_kind", "source_sha256", "persona_id",
    "persona_version", "persona_provenance", "status", "coverage", "synthetic_signal",
    "confidence", "three_second_reaction", "relevance", "frictions", "preserve",
    "questions", "limitations", "method_observations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "worker_result_id": {"type": "string"},
    "reviewer_kind": {"enum": ["persona", "professional"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "persona_id": {"type": "string"},
    "persona_version": {"type": "string"},
    "persona_provenance": {"enum": ["grounded", "inferred", "operator_hypothesis", "synthetic"]},
    "status": {"const": "completed"},
    "synthetic_signal": {"enum": ["strong", "medium", "weak", "reject"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "frictions": {"type": "array"},
    "preserve": {"type": "array"},
    "questions": {"type": "array"},
    "limitations": {"type": "array"},
    "method_observations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
